{
  "name": "iodine-ide",
  "version": "0.4.0",
  "description": "IDE for open-source development",
  "license": "MIT",
  "bin": {
    "iodine": "./bin/iodine.js"
  },
  "files": [
    "bin/",
    "server/dist/",
    "client/dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@google/genai": "^2.17.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.0",
    "node-pty": "^1.1.0",
    "openai": "^6.45.0",
    "ws": "^8.21.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=client && npm run test --workspace=server",
    "typecheck": "npm run typecheck --workspace=client && npm run typecheck --workspace=server",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
